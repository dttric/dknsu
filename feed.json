---
layout: null
---
{
  "articles": [
    {% for post in site.posts limit:3 %}
    {
      "id": "post-{{ forloop.index }}",
      "category": {{ post.category | default: "article" | jsonify }},
      "tag": {{ post.tag | default: post.category | jsonify }},
      "title": {{ post.title | jsonify }},
      "date": "{{ post.date | date: "%Y-%m-%d" }}",
      "url": {{ post.url | remove: ".html" | jsonify }},
      "summary": {{ post.excerpt | strip_html | strip_newlines | jsonify }},
      "author": {{ post.author | default: "dkn team" | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}